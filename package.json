{
  "name": "leaveo-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "dev:public": "LEAVEO_ARTIFACT=public WEB_PORT=4174 vite",
    "dev:journey": "bash scripts/run-dev-journey.sh",
    "build": "tsc -b && npm run build:public && npm run build:app && npm run build:admin && npm run verify:artifacts",
    "build:public": "LEAVEO_ARTIFACT=public vite build && LEAVEO_ARTIFACT=public-render vite build && node scripts/generate-public.mjs && node scripts/verify-public-output.mjs",
    "build:app": "LEAVEO_ARTIFACT=customer vite build && node scripts/finalize-spa-artifact.mjs app",
    "build:admin": "LEAVEO_ARTIFACT=admin vite build && node scripts/finalize-spa-artifact.mjs admin",
    "lint": "eslint .",
    "typecheck:tests": "tsc -p tsconfig.test.json && tsc -p tsconfig.e2e.json",
    "preview": "node scripts/serve-spa-artifacts.mjs",
    "preview:public": "node scripts/serve-public.mjs",
    "test": "vitest",
    "test:ci": "vitest run --reporter=dot",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --reporter=line,./tests/support/contracted-execution-reporter.ts",
    "test:e2e:ui-only": "playwright test --grep @ui-only --reporter=line",
    "test:e2e:smoke": "playwright test --grep @smoke --reporter=line",
    "test:e2e:regression": "playwright test --grep @regression --reporter=line",
    "test:e2e:api-only": "playwright test --grep @api --reporter=line",
    "test:e2e:public": "PUBLIC_SITE_URL=http://127.0.0.1:4174 VITE_PUBLIC_TURNSTILE_SITE_KEY=${VITE_PUBLIC_TURNSTILE_SITE_KEY:-1x00000000000000000000AA} npm run build:public && E2E_PUBLIC_ARTIFACT=true playwright test tests/e2e/public-entry-boundaries.spec.ts tests/e2e/paid-registration.spec.ts tests/e2e/accessibility-completion.spec.ts tests/e2e/free-registration.spec.ts tests/e2e/pricing-routing.spec.ts --grep @ui-only --reporter=line",
    "test:e2e:smoke:api": "bash scripts/run-e2e-with-api.sh --grep @smoke",
    "test:e2e:regression:api": "bash scripts/run-e2e-with-api.sh --grep @regression",
    "test:e2e:ui-only:ci": "playwright test --grep @ui-only",
    "test:e2e:regression:ci": "playwright test --grep @regression",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:api": "bash scripts/run-e2e-with-api.sh",
    "verify:brand": "bash scripts/verify-brand.sh",
    "verify:e2e-tags": "playwright test --list --reporter=./tests/support/tag-integrity-reporter.ts",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "verify:openapi": "bash scripts/verify-openapi-types.sh",
    "verify:public": "node scripts/verify-public-output.mjs",
    "verify:artifacts": "node scripts/verify-artifact-boundaries.mjs",
    "generate:api": "openapi-typescript http://localhost:8080/v3/api-docs -o src/api/generated/types.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "i18next": "^26.3.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.9",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^16.6.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
